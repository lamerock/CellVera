<Window x:Class="CellVera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CellVera — Battery Health"
        Icon="Assets/CellVera.ico"
        Height="680"
        Width="1000"
        MinHeight="610"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="Assets/CellVera.ico"
                       Width="32"
                       Height="32"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CellVera"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="LastUpdatedText"
                               Text="Reading battery…"
                               FontSize="11"
                               Foreground="{DynamicResource SubtleBrush}"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SystemThemeRadio"
                                     Content="System"
                                     GroupName="ThemeMode"
                                     Tag="System"
                                     Style="{StaticResource ThemeSegmentButton}"
                                     Checked="ThemeMode_Checked"
                                     ToolTip="Follow Windows theme"/>
                        <RadioButton x:Name="LightThemeRadio"
                                     Content="Light"
                                     GroupName="ThemeMode"
                                     Tag="Light"
                                     Style="{StaticResource ThemeSegmentButton}"
                                     Checked="ThemeMode_Checked"/>
                        <RadioButton x:Name="DarkThemeRadio"
                                     Content="Dark"
                                     GroupName="ThemeMode"
                                     Tag="Dark"
                                     Style="{StaticResource ThemeSegmentButton}"
                                     Checked="ThemeMode_Checked"/>
                    </StackPanel>
                </Border>

                <Button x:Name="RefreshButton"
                        Grid.Column="4"
                        Style="{StaticResource SecondaryButton}"
                        Content="Refresh"
                        Click="Refresh_Click"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="Refresh battery information"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Background="{DynamicResource BgBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Grid Margin="20,16,20,20" MaxWidth="1100" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact primary summary -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="0.85*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="CURRENT CHARGE" Style="{StaticResource SectionEyebrow}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="ChargeText"
                                           Text="--%"
                                           FontSize="44"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Border x:Name="StateBadge"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="8"
                                        Padding="8,4"
                                        Margin="12,8,0,0"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="StateText"
                                               Text="Reading…"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <ProgressBar x:Name="ChargeProgress"
                                         Style="{StaticResource ModernProgressBar}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,8,0,0"/>
                            <TextBlock x:Name="BatteryNameText"
                                       Text="Battery"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,7,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

                        <StackPanel Grid.Column="2" Margin="18,0">
                            <TextBlock Text="BATTERY HEALTH" Style="{StaticResource SectionEyebrow}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="HealthText"
                                           Text="--%"
                                           FontSize="35"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="HealthLabelText"
                                           Text="Checking…"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Margin="10,0,0,6"/>
                            </StackPanel>
                            <ProgressBar x:Name="HealthBar"
                                         Style="{StaticResource ModernProgressBar}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,8,0,0"/>
                            <TextBlock x:Name="WearText"
                                       Text="Wear unavailable"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="3" Background="{DynamicResource BorderBrush}"/>

                        <StackPanel Grid.Column="4" Margin="18,0,0,0">
                            <TextBlock Text="POWER STATUS" Style="{StaticResource SectionEyebrow}"/>
                            <TextBlock x:Name="RuntimeText"
                                       Text="Not available"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="PowerSourceText"
                                       Text="Checking…"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="Auto refresh · 15 sec"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       FontSize="11"
                                       Margin="0,9,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dense metric strip -->
                <UniformGrid Grid.Row="2" Columns="6" Rows="1">
                    <Border Style="{StaticResource MetricTileStyle}" ToolTip="Original rated battery capacity">
                        <StackPanel>
                            <TextBlock Text="Design" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="DesignCapacityText" Text="—" Style="{StaticResource ValueText}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileStyle}" ToolTip="Current maximum full-charge capacity">
                        <StackPanel>
                            <TextBlock Text="Full charge" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="FullCapacityText" Text="—" Style="{StaticResource ValueText}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileStyle}" ToolTip="Charge-cycle count when exposed by firmware">
                        <StackPanel>
                            <TextBlock Text="Cycles" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="CycleText" Text="—" Style="{StaticResource ValueText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileStyle}" ToolTip="Battery temperature when exposed by firmware">
                        <StackPanel>
                            <TextBlock Text="Temperature" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource ValueText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileStyle}">
                        <StackPanel>
                            <TextBlock Text="Voltage" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="VoltageText" Text="—" Style="{StaticResource ValueText}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTileStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Power flow" Style="{StaticResource LabelText}"/>
                            <TextBlock x:Name="PowerFlowText" Text="—" Style="{StaticResource ValueText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- History + settings/tools -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Charge history" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Last 24 hours · stored locally on this PC"
                                               Style="{StaticResource LabelText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="ClearHistoryButton"
                                        Grid.Column="1"
                                        Content="Clear"
                                        Style="{StaticResource QuietButton}"
                                        Click="ClearHistory_Click"
                                        ToolTip="Delete CellVera's locally stored charge history"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <Grid>
                                    <Canvas x:Name="HistoryCanvas"
                                            Margin="10,8"
                                            SizeChanged="HistoryCanvas_SizeChanged"/>
                                    <TextBlock x:Name="HistoryEmptyText"
                                               Text="History will appear as CellVera records battery changes."
                                               Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="24"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="HistorySummaryText"
                                       Grid.Row="3"
                                       Text="No charge history yet"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,9,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="App behavior" Style="{StaticResource SectionTitle}"/>

                            <CheckBox x:Name="NotificationsCheckBox"
                                      Content="Battery notifications"
                                      Style="{StaticResource AppCheckBox}"
                                      FontWeight="SemiBold"
                                      Margin="0,13,0,0"
                                      Click="NotificationsCheckBox_Click"
                                      ToolTip="Alert at 20%, 10%, and when fully charged"/>
                            <TextBlock Text="Low, critical, and fully charged alerts."
                                       Style="{StaticResource LabelText}"
                                       Margin="22,3,0,0"
                                       TextWrapping="Wrap"/>

                            <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,13"/>

                            <TextBlock Text="System tray" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Minimizing hides CellVera to the tray. Double-click the tray icon to restore it."
                                       Style="{StaticResource LabelText}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>

                            <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,13"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Generate battery report"
                                    Click="GenerateReport_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Open power settings"
                                    Click="PowerSettings_Click"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
