<Window x:Class="CellVera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CellVera — Battery Health"
        Icon="Assets/CellVera.ico"
        Height="800"
        Width="1120"
        MinHeight="680"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent header: identity, theme choice, live status, and refresh. -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="Assets/CellVera.ico"
                       Width="40"
                       Height="40"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CellVera"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Battery health &amp; power insights"
                               FontSize="12"
                               Foreground="{DynamicResource SubtleBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock x:Name="LastUpdatedText"
                           Grid.Column="2"
                           Text="Reading battery…"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="20,0,18,0"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="3"
                           Text="Theme"
                           Style="{StaticResource LabelText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Border Grid.Column="4"
                        Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SystemThemeRadio"
                                     Content="System"
                                     GroupName="ThemeMode"
                                     Tag="System"
                                     Style="{StaticResource ThemeSegmentButton}"
                                     Checked="ThemeMode_Checked"
                                     ToolTip="Follow the Windows app theme"
                                     AutomationProperties.Name="Use Windows system theme"/>
                        <RadioButton x:Name="LightThemeRadio"
                                     Content="Light"
                                     GroupName="ThemeMode"
                                     Tag="Light"
                                     Style="{StaticResource ThemeSegmentButton}"
                                     Checked="ThemeMode_Checked"
                                     ToolTip="Always use the light theme"
                                     AutomationProperties.Name="Use light theme"/>
                        <RadioButton x:Name="DarkThemeRadio"
                                     Content="Dark"
                                     GroupName="ThemeMode"
                                     Tag="Dark"
                                     Style="{StaticResource ThemeSegmentButton}"
                                     Checked="ThemeMode_Checked"
                                     ToolTip="Always use the dark theme"
                                     AutomationProperties.Name="Use dark theme"/>
                    </StackPanel>
                </Border>

                <Button x:Name="RefreshButton"
                        Grid.Column="5"
                        Style="{StaticResource SecondaryButton}"
                        Content="Refresh"
                        Click="Refresh_Click"
                        Margin="12,0,0,0"
                        AutomationProperties.Name="Refresh battery information"
                        ToolTip="Read battery information now"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Grid Margin="28,26,28,30" MaxWidth="1180" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Primary status card -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="CURRENT BATTERY" Style="{StaticResource SectionEyebrow}"/>
                            <TextBlock x:Name="BatteryNameText"
                                       Text="Battery"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>

                            <Border x:Name="StateBadge"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="9"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0">
                                <TextBlock x:Name="StateText"
                                           Text="Reading status…"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,4" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ChargeText"
                                           Text="--%"
                                           FontSize="54"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           LineHeight="58"/>
                                <TextBlock Text=" charged"
                                           FontSize="16"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="6,0,0,9"/>
                            </StackPanel>

                            <ProgressBar x:Name="ChargeProgress"
                                         Style="{StaticResource ModernProgressBar}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,6,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource PanelRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Estimated remaining" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="RuntimeText"
                                           Text="Not available"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,5,0,18"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Power source" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="PowerSourceText"
                                           Text="Checking…"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,4,0,18"/>

                                <TextBlock Text="Automatic refresh" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="Every 15 seconds"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Health + capacity snapshot -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="BATTERY HEALTH" Style="{StaticResource SectionEyebrow}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HealthText"
                                           Text="--%"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Grid.Column="1" Margin="16,5,0,0">
                                    <TextBlock x:Name="HealthLabelText"
                                               Text="Checking…"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Full-charge vs. design capacity"
                                               Style="{StaticResource LabelText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar x:Name="HealthBar"
                                         Style="{StaticResource ModernProgressBar}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,18,0,10"/>
                            <TextBlock x:Name="WearText"
                                       Text="Wear level unavailable"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="CAPACITY &amp; CONDITION" Style="{StaticResource SectionEyebrow}"/>
                            <UniformGrid Columns="2" Rows="2" Margin="0,12,-10,-10">
                                <Border Style="{StaticResource MetricTileStyle}"
                                        ToolTip="The battery's original rated capacity.">
                                    <StackPanel>
                                        <TextBlock Text="Design capacity" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="DesignCapacityText" Text="—" Style="{StaticResource ValueText}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricTileStyle}"
                                        ToolTip="The maximum capacity the battery can currently hold.">
                                    <StackPanel>
                                        <TextBlock Text="Full-charge capacity" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="FullCapacityText" Text="—" Style="{StaticResource ValueText}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricTileStyle}"
                                        ToolTip="Charge-cycle count, when exposed by the laptop firmware.">
                                    <StackPanel>
                                        <TextBlock Text="Cycle count" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="CycleText" Text="—" Style="{StaticResource ValueText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricTileStyle}"
                                        ToolTip="Battery temperature, when exposed by the battery driver.">
                                    <StackPanel>
                                        <TextBlock Text="Temperature" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource ValueText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Technical details + useful Windows actions -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Electrical details" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Live values reported by Windows and the battery firmware."
                                       Style="{StaticResource LabelText}"
                                       Margin="0,5,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Voltage" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VoltageText" Grid.Column="1" Text="—" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource BorderBrush}" Opacity="0.75"/>

                                <TextBlock Grid.Row="2" Text="Charge rate" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChargeRateText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource BorderBrush}" Opacity="0.75"/>

                                <TextBlock Grid.Row="4" Text="Discharge rate" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DischargeRateText" Grid.Row="4" Grid.Column="1" Text="—" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Windows tools" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Use the built-in Windows report for history, or open power settings."
                                       Style="{StaticResource LabelText}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,18"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Generate battery report"
                                    Click="GenerateReport_Click"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Generate Windows battery report"
                                    ToolTip="Create an HTML battery report in Documents and open it"/>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Open power settings"
                                    Click="PowerSettings_Click"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="Open Windows power settings"
                                    ToolTip="Open Windows Power &amp; battery settings"/>

                            <TextBlock Text="Charge thresholds are controlled by the laptop manufacturer. CellVera reads battery data but does not change OEM charging limits."
                                       Foreground="{DynamicResource SubtleBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Contextual guidance without a permanent navigation panel. -->
                <Border Grid.Row="6"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="i"
                                   Width="26"
                                   Height="26"
                                   TextAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Battery care"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Heat accelerates battery wear. When practical, avoid sustained high temperatures and long periods at 100% charge."
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
